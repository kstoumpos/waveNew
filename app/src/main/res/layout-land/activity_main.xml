<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A2323"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Menu -->
        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu"
            android:contentDescription="@string/menu_button" />

        <!-- Cast -->
        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/mediaRouteButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@id/menuButton"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:mediaRouteTypes="user" />

        <!-- Header / Logo -->
        <ImageView
            android:id="@+id/background_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:src="@drawable/logomobile" />

        <!-- Play / Stop Button -->
        <FrameLayout
            android:id="@+id/playStopContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/background_image"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="5dp"
            android:elevation="8dp">

            <ImageButton
                android:id="@+id/playButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:padding="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:background="@drawable/bg_button_circle"
                android:contentDescription="@string/play" />

            <ImageButton
                android:id="@+id/stopButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:padding="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_stop"
                android:visibility="gone"
                android:background="@drawable/bg_button_circle"
                android:contentDescription="@string/stop" />

        </FrameLayout>

        <!-- Loading Status -->
        <TextView
            android:id="@+id/loadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/playStopContainer"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="0dp"
            android:text="@string/connecting"
            android:textColor="#00FFFFFF"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:visibility="invisible" />

        <!-- Main Text -->
        <TextView
            android:id="@+id/mainText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/loadingStatus"
            android:layout_marginTop="12dp"
            android:paddingStart="50dp"
            android:paddingEnd="50dp"
            android:text="@string/main_text"
            android:textAlignment="center"
            android:textColor="#C2D2B9"
            android:textSize="32sp"
            android:fontFamily="@font/black_mango_regular"
            android:visibility="visible" />

        <!-- Social Media Buttons -->
        <LinearLayout
            android:id="@+id/social_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@+id/mainText"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="30dp">

            <ImageButton
                android:id="@+id/instagram"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/instagram"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/instagram" />

            <ImageButton
                android:id="@+id/facebook"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/facebook"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/facebook" />

            <ImageButton
                android:id="@+id/spotify"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/spotify"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/spotify" />

            <ImageButton
                android:id="@+id/youtube"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/youtube"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/youtube" />

            <ImageButton
                android:id="@+id/website"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/website"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/website" />

        </LinearLayout>

    </RelativeLayout>

</ScrollView>
